{
  "name": "c-learn",
  "version": "0.1.0",
  "private": true,
  "description": "面向零基础学习者的 C 语言学习桌面应用",
  "author": "c-learn contributors",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:native": "node scripts/build-native.mjs",
    "content:build": "node scripts/content/build.mjs",
    "content:verify": "node scripts/content/build.mjs --verify",
    "test:judge": "node tests/judge/run-judge-tests.mjs",
    "dev": "node scripts/dev.mjs",
    "build:ui": "vite build",
    "start": "vite build && electron .",
    "selftest": "vite build && node scripts/selftest.mjs",
    "test:server": "node --test tests/server/service.test.mjs",
    "dist": "node scripts/prepare-dist.mjs && vite build && electron-builder --win nsis --x64",
    "dist:dir": "node scripts/prepare-dist.mjs && vite build && electron-builder --win --dir"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/cpp": "^1.1.6",
    "@lezer/highlight": "^1.2.5",
    "markdown-it": "^15.0.3",
    "pinia": "^4.1.0",
    "vue": "^3.5.46",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.11",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.8"
  },
  "main": "electron/main.js"
}
